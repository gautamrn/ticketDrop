DOMAIN=ticketdrop.example.com
ACME_EMAIL=you@example.com

POSTGRES_USER=ticketdrop
POSTGRES_PASSWORD=replace-with-32-random-characters
POSTGRES_DB=ticketdrop
REDIS_PASSWORD=replace-with-32-random-characters
REDIS_MAXMEMORY=256mb

RA_GRAPHQL_URL=https://ra.co/graphql
RA_USER_AGENT=TicketDrop/1.0 (+https://ticketdrop.example.com; contact: you@example.com)
RA_AREAS=19
RA_LOOKAHEAD_DAYS=60
POLL_INTERVAL_MS=5000
POLL_TIMEOUT_MS=4000
RA_BATCH_SIZE=100
RA_WORKERS=6
RA_QUEUE_SIZE=150
RA_ENUMERATE_INTERVAL_MS=900000

HARNESS_MAX_CONCURRENCY=4
SCOUT_INTERVAL_MS=60000
SCOUT_TIMEOUT_MS=5000
SUBSCRIPTION_RECONCILE_INTERVAL_MS=15000
SUBSCRIPTION_RECONCILE_TIMEOUT_MS=5000

AUTH_SECRET=replace-with-at-least-32-random-bytes
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

RESEND_API_KEY=re_replace_with_resend_key
ALERT_FROM_EMAIL=TicketDrop <alerts@ticketdrop.example.com>
UNSUBSCRIBE_SECRET=replace-with-at-least-32-random-bytes

LOG_LEVEL=info
